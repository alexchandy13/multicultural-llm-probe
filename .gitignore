# Data, weights, checkpoints, outputs — never commit. The whole directories
# are excluded so that on HPC these can safely be symlinks to scratch without
# git seeing them. .gitkeep stubs no longer needed since `data/`,
# `checkpoints/`, and `outputs/` are reconstructed at first run by the
# training/eval/CULNIG scripts themselves.
data/*
!data/*.py
!data/*.csv
models/
checkpoints/
outputs/

# CULNIG upstream clone — pulled separately
culnig/_upstream/

# SLURM artifacts
slurm/*.out
slurm/*.err
*.log

# Cluster job logs pulled down wholesale before the Oct 2026 maintenance window.
# 2,410 files / 334 MB of stdout+stderr, kept locally as the only record of what
# ran (countries resolved, countryrc drop rates, rank-1 percentages, timings)
# since the cluster copies are not guaranteed to survive. Never committed.
slurm_cluster_logs/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Env
.env
.venv/
venv/

# OS
.DS_Store
Thumbs.db
